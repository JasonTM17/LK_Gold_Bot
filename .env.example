# Telegram Bot token from @BotFather
BOT_TOKEN=

# Your Telegram user id for admin commands. Example: 123456789
ADMIN_ID=0

# Runtime settings
DEFAULT_LANG=VI
NUM_WORKERS=2
DAILY_LIMIT=5

# Optional: send a photo with the final checklist. Leave blank to send text only.
DONATE_PHOTO=

# Optional: custom project name shown in /start
PROJECT_NAME=LK Gold Bot

# Optional NextDNS profile creation for your personal content filtering/privacy setup
ENABLE_NEXTDNS=false
NEXTDNS_KEY=
NEXTDNS_BLOCKLIST=example.com

# Optional custom paths. Keep these outside Git if they contain runtime data.
DATA_DIR=./data
DB_PATH=./data/bot_data.db